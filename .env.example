# Postgres 16 (docker compose up -d db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whizz

# Sem chave, o backend roda em LLM_MODE=mock (entrevistador e avaliador roteirizados)
ANTHROPIC_API_KEY=
LLM_MODE=
INTERVIEWER_MODEL=claude-sonnet-5-5
EVALUATOR_MODEL=claude-opus-5-5
RUBRIC_MODEL=claude-opus-5-5

API_PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
