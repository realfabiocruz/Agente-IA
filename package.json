{
  "name": "agente-ia-whizz",
  "private": true,
  "workspaces": ["apps/api", "apps/web", "apps/voice-agent"],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run prisma:migrate -w apps/api",
    "db:seed": "npm run prisma:seed -w apps/api",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/api && npm run build -w apps/voice-agent && npm run build -w apps/web",
    "dev:voice": "npm run dev -w apps/voice-agent",
    "test": "npm test -w apps/api"
  }
}
